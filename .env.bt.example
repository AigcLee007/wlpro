NODE_ENV=production
APP_NAME=武陵商厦创作平台
GENERATION_RECORD_SUCCESS_RETENTION_DAYS=5
GENERATION_RECORD_FAILED_RETENTION_DAYS=5
GENERATION_RECORD_PENDING_RETENTION_DAYS=5
GENERATION_RECORD_PENDING_STALE_MINUTES=120
GENERATED_ASSET_PERSIST_ALL_IMAGES=true
LINE4_LOCAL_STORAGE_TTL_HOURS=120
PORT=3355

# New user signup bonus points. Keep 0 if you do not want a free trial.
DEFAULT_SIGNUP_POINTS=0

# The first registered account becomes super_admin automatically.
# Emails listed here are also granted admin access.
ADMIN_EMAILS=admin@example.com,ops@example.com

# MySQL
# docker-compose connects the app to the mysql service automatically.
# MYSQL_HOST_PORT is only the host-side bind port used by Docker.
MYSQL_URL=
MYSQL_HOST_PORT=3308
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_a_strong_password_at_least_16_chars
MYSQL_DATABASE=nano_banana_pro
MYSQL_CONNECTION_LIMIT=10

# Runtime safety for 4 GB servers.
NODE_OPTIONS=--max-old-space-size=1536
BILLING_PENDING_TASK_TIMEOUT_MINUTES=90
BILLING_VIDEO_PENDING_TASK_TIMEOUT_MINUTES=360

# Built-in image route keys
IMAGE_ROUTE_DEFAULT_KEY=replace_with_your_default_route_key
IMAGE_ROUTE_NANO_BANANA_PRO_LINE1_KEY=replace_with_your_line1_key
IMAGE_ROUTE_NANO_BANANA_PRO_LINE2_KEY=replace_with_your_line2_key
IMAGE_ROUTE_NANO_BANANA_PRO_LINE3_KEY=replace_with_your_line3_key

# If you later add line4 / line5 / line6 in the admin panel and fill apiKeyEnv,
# just keep adding the matching variables here.
# docker-compose passes the whole .env file into the app container.
# Example:
# IMAGE_ROUTE_NANO_BANANA_PRO_LINE4_KEY=replace_with_your_line4_key

# Email verification / forgot password
# Recommended: Resend SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_replace_with_your_resend_api_key
SMTP_FROM=Nano Banana Pro <noreply@yourdomain.com>

# Server-side Gemini / compatible upstream key for prompt tools.
# This is read only by the backend. Do not expose it in frontend code.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://api.bltcy.ai
PROMPT_TOOL_MODEL=gemini-3.1-pro-preview
PROMPT_OPTIMIZE_COST=0.5
REVERSE_PROMPT_COST=1

# Emergency server-side admin keys
BILLING_ADMIN_API_KEY=replace_with_a_long_random_string
ANNOUNCEMENT_ADMIN_API_KEY=replace_with_another_long_random_string

# Generated image asset persistence (optional, off by default)
# Turn on only after your bucket/CDN is configured. Videos are not uploaded.
GENERATED_ASSET_STORAGE=off
GENERATED_ASSET_PROVIDER=aliyun-oss
GENERATED_ASSET_PUBLIC_BASE_URL=https://img.example.com
GENERATED_ASSET_BUCKET=your_bucket_name
GENERATED_ASSET_PREFIX=generated/images
GENERATED_ASSET_MAX_BYTES=52428800
GENERATED_ASSET_DOWNLOAD_TIMEOUT_MS=30000
GENERATED_ASSET_CACHE_CONTROL=public, max-age=31536000, immutable

# Aliyun OSS provider
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=your_oss_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret

# S3-compatible / Cloudflare R2 provider
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Notes:
# 1. Copy this file to .env on a fresh server only. Existing servers should keep their current .env.
# 2. Never commit your real .env to a public repository.
# 3. BaoTa reverse proxy target: http://127.0.0.1:3355
